# Virtual environment
.venv/

# Credentials — use config.example.py as a template
config.py

# MicroPython compiled bytecode
*.mpy

# PyCharm personal IDE state
.idea/workspace.xml

# OS
.DS_Store
Thumbs.db
# Per-device configs — copy the matching *.example.py and fill in your values
config_*.py
!*.example.py

# Private keys / CSRs / CA serials anywhere in the repo (certs/ has its own .gitignore too)
*.key
*.csr
*.srl
